{
  "name": "qla-fit-mobile",
  "version": "1.7.0",
  "private": true,
  "expo": {
    "autolinking": {
      "exclude": [
        "@expo/dom-webview"
      ]
    }
  },
  "scripts": {
    "android": "expo run:android",
    "ios": "expo run:ios",
    "knip": "knip",
    "i18n:audit": "node scripts/audit-mobile-i18n.mjs",
    "prebuild": "expo prebuild --clean",
    "lint": "expo lint src App.tsx index.js __tests__ --max-warnings 0",
    "lint:compiler": "eslint --no-config-lookup --config eslint.compiler.config.js src App.tsx",
    "start": "expo start",
    "test": "jest",
    "test:run": "jest",
    "test:watch": "jest --watchAll",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --maxWorkers=2",
    "typecheck": "tsc --noEmit",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "validate": "pnpm run i18n:generate:check && pnpm run typecheck && pnpm run lint && pnpm run i18n:audit && pnpm run knip && pnpm run native-locales:check && pnpm run format:check",
    "i18n:generate": "node scripts/generate-locale-resources.mjs",
    "i18n:generate:check": "node scripts/generate-locale-resources.mjs --check",
    "native-locales:check": "node scripts/validate-native-widget-locales.mjs"
  },
  "dependencies": {
    "@assistant-ui/react-ai-sdk": "^1.3.37",
    "@assistant-ui/react-native": "^0.1.27",
    "@bacons/apple-targets": "4.0.6",
    "@better-auth/expo": "1.5.6",
    "@better-auth/sso": "1.5.6",
    "@bottom-tabs/react-navigation": "^1.5.0",
    "@bsky.app/expo-scroll-edge-effect": "0.1.10",
    "@expo/dom-webview": "~58.0.2",
    "@expo/ui": "~58.0.25",
    "@expo/vector-icons": "^15.0.2",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@kingstinct/react-native-healthkit": "^13.3.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-clipboard/clipboard": "^1.16.0",
    "@react-native-google-signin/google-signin": "^16.1.5",
    "@react-navigation/bottom-tabs": "^7.15.6",
    "@react-navigation/elements": "2.9.40",
    "@react-navigation/native": "^7.2.2",
    "@react-navigation/native-stack": "^7.4.2",
    "@shopify/react-native-skia": "2.14.0",
    "@tanstack/react-query": "^5.90.20",
    "@workspace/shared": "workspace:*",
    "better-auth": "1.5.6",
    "expo": "~58.0.21",
    "expo-apple-authentication": "~58.0.2",
    "expo-application": "~58.1.2",
    "expo-asset": "~58.0.19",
    "expo-audio": "~58.0.10",
    "expo-auth-session": "~58.0.16",
    "expo-background-task": "~58.0.11",
    "expo-build-properties": "~58.0.11",
    "expo-camera": "~58.0.14",
    "expo-constants": "~58.0.14",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.17",
    "expo-device": "~58.0.5",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-glass-effect": "~58.0.5",
    "expo-haptics": "~58.0.7",
    "expo-health-connect": "^0.1.1",
    "expo-image": "~58.0.18",
    "expo-image-manipulator": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-keep-awake": "~58.0.3",
    "expo-linking": "~58.0.15",
    "expo-localization": "~58.0.5",
    "expo-location": "~58.0.20",
    "expo-maps": "~58.0.11",
    "expo-modules-core": "~58.0.28",
    "expo-navigation-bar": "~58.0.4",
    "expo-network": "~58.0.4",
    "expo-notifications": "~58.1.7",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.21",
    "expo-splash-screen": "~58.0.12",
    "expo-sqlite": "~58.0.14",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-task-manager": "~58.0.12",
    "expo-updates": "~58.0.19",
    "expo-web-browser": "~58.0.7",
    "expo-widgets": "~58.0.25",
    "i18next": "25.8.18",
    "ipaddr.js": "^2.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "16.5.8",
    "react-native": "0.88.1",
    "react-native-ble-plx": "^3.5.1",
    "react-native-bottom-tabs": "^1.5.0",
    "react-native-enriched-markdown": "0.6.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-health-connect": "3.5.3",
    "react-native-keyboard-controller": "1.22.7",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-pager-view": "9.0.7",
    "react-native-purchases": "^10.10.1",
    "react-native-purchases-ui": "^10.10.1",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-toast-message": "^2.3.3",
    "react-native-ui-datepicker": "^3.1.2",
    "react-native-worklets": "0.13.0",
    "remend": "1.2.2",
    "tailwindcss": "^4.1.18",
    "uniwind": "^1.7.0",
    "victory-native": "^42.0.1",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/runtime": "^7.25.0",
    "@expo/ngrok": "^4.1.3",
    "@react-native/jest-preset": "0.88.1",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "babel-jest": "~30.5.2",
    "babel-preset-expo": "~58.0.0",
    "eslint": "^9.39.3",
    "eslint-config-expo": "~58.0.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "expo-atlas": "^0.4.0",
    "jest": "~30.5.2",
    "jest-environment-jsdom": "~30.5.2",
    "jest-expo": "~58.0.13",
    "knip": "^6.32.3",
    "prettier": "3.9.6",
    "radon-ide": "^0.0.1",
    "react-test-renderer": "19.3.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "testEnvironment": "<rootDir>/jest.environment.js",
    "setupFilesAfterEnv": [
      "./jest.setup.js"
    ],
    "testPathIgnorePatterns": [
      "/.kilo/",
      "/.claude/",
      "__tests__/helpers/",
      "__tests__/hooks/queryTestUtils\\.ts$",
      "__tests__/screens/helpers/",
      "__tests__/config/helpers/"
    ],
    "moduleNameMapper": {
      "^@workspace/shared$": "<rootDir>/shared/src/index.ts",
      "^@babel/runtime/(.*)$": "<rootDir>/node_modules/@babel/runtime/$1",
      "^remend$": "<rootDir>/node_modules/remend/dist/index.js",
      "^react$": "<rootDir>/node_modules/react",
      "^react/(.*)$": "<rootDir>/node_modules/react/$1",
      "^expo/src/winter$": "<rootDir>/__mocks__/expo-winter.js"
    },
    "transform": {
      "^.+\\.mjs$": [
        "babel-jest",
        {
          "presets": [
            "babel-preset-expo"
          ],
          "babelrc": false,
          "configFile": false
        }
      ]
    },
    "transformIgnorePatterns": [
      "node_modules/(?!(?:.pnpm/[^/]+/node_modules/)?((jest-)?react-native|@react-native(-community)?|expo[^/]*|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@sentry/react-native|native-base|react-native-svg|@shopify/react-native-skia|react-native-ui-datepicker|@workspace/shared|remend|zod|better-auth|@better-auth/.*|@better-fetch/.*|nanostores|jose|@noble/.*|better-call|defu)/)"
    ],
    "collectCoverage": true,
    "collectCoverageFrom": [
      "**/*.{ts,tsx,js,jsx}",
      "!**/coverage/**",
      "!**/node_modules/**",
      "!**/babel.config.js",
      "!**/metro.config.js",
      "!**/eslint.config.js",
      "!**/expo-env.d.ts",
      "!**/.expo/**",
      "!**/devdocs/**",
      "!**/.kilo/**",
      "!**/.claude/**"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/.kilo/",
      "<rootDir>/.claude/"
    ]
  },
  "packageManager": "pnpm@10.33.4",
  "pnpm": {
    "supportedArchitectures": {
      "os": [
        "current"
      ],
      "cpu": [
        "current",
        "x64",
        "arm64"
      ]
    },
    "overrides": {
      "side-channel": "1.0.6",
      "tailwindcss": "4.2.1",
      "assistant-cloud": "0.1.33",
      "zustand": "5.0.14"
    }
  }
}
