<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Declares this APK as the watch half of the pair. Wear OS installs it
         on a paired watch when the phone app is installed. -->
    <uses-feature android:name="android.hardware.type.watch" />

    <!-- Health Services reads heart rate during a session. Wear OS 5 moved
         that behind the Health Connect style permission; BODY_SENSORS stays
         for older watches, which still check it. -->
    <uses-permission android:name="android.permission.health.READ_HEART_RATE" />
    <uses-permission android:name="android.permission.BODY_SENSORS" />
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_HEALTH" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault">

        <!-- false: the watch app is a companion, like the watchOS one
             (WKRunsIndependentlyOfCompanionApp is false there too). It needs
             the phone for the diary; standalone would promise otherwise. -->
        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:taskAffinity=""
            android:label="@string/app_name"
            android:theme="@android:style/Theme.DeviceDefault">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Receives Data Layer messages from the phone even when the watch
             app is not in the foreground; this is what the phone's probe and
             its programs/dashboard pushes land on. -->
        <service
            android:name=".WearLinkService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data android:scheme="wear" android:host="*" android:pathPrefix="/qlafit" />
            </intent-filter>
        </service>
    </application>
</manifest>
