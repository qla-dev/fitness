<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools" tools:keep="@array/android_wear_capabilities">
    <!-- How the phone tells a paired watch actually carries this app, which is
         what `isWatchAppInstalled` reports. Without a declared capability the
         phone can only see that some watch exists, not that ours is on it. -->
    <string-array name="android_wear_capabilities">
        <item>qlafit_wear_app</item>
    </string-array>
</resources>
