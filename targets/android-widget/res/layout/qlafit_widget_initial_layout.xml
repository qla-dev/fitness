<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="#FFF9FAFB"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_widget_preview_arcs" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/widget_preview_calories_left"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#FF5087F7"
            android:maxLines="1" />
    </LinearLayout>

    <TextView
        android:layout_width="1dp"
        android:layout_height="24dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="4dp"
        android:text=""
        android:background="#FFE1E5EA" />

    <LinearLayout
        android:layout_width="32dp"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:padding="4dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_widget_search"
            android:tint="#FF5087F7"
            android:contentDescription="@string/widget_search_food" />

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:padding="4dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_widget_scan"
            android:tint="#FF5087F7"
            android:contentDescription="@string/widget_scan_barcode" />
    </LinearLayout>
</LinearLayout>
