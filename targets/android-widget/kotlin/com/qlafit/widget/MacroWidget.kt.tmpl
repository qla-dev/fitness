/**
 * The Tracker's nutrient rings in the fixed 2x2 footprint: the localized
 * remaining-calories header, protein / carbs / fat as rings in their own colours with
 * the grams inside and what is left of each goal below, and the search/scan
 * shortcut row. Strings, accessibility labels and numbers follow the
 * app/system language.
 */
class MacroWidget : GlanceAppWidget() {

    override val stateDefinition = PreferencesGlanceStateDefinition

    // Classic pre-localization size mode: a single 200x200 responsive size
    // matching the fixed 2x2 launcher footprint. No resizing.
    override val sizeMode: SizeMode = SizeMode.Responsive(
        setOf(DpSize(200.dp, 200.dp)),
    )

    override suspend fun provideGlance(context: Context, id: GlanceId) {
        val fallbackSnapshot = loadSnapshot(context)
        provideContent {
            GlanceTheme {
                WidgetContent(context = context, fallbackSnapshot = fallbackSnapshot)
            }
        }
    }

    @Composable
    private fun WidgetContent(context: Context, fallbackSnapshot: MacroSnapshot?) {
        val state = currentState<Preferences>()
        // Observe the dedicated revision so an active Glance session recomposes
        // after a language-only invalidation.
        currentState(WidgetLocale.LOCALE_RENDER_REVISION_STATE_KEY)
        val snapshot = parseSnapshot(state[SNAPSHOT_STATE_KEY]) ?: fallbackSnapshot

        // Widget-only locale override: localized string and number resolution
        // stay local to widget rendering (see WidgetLocale).
        val widgetContext = WidgetLocale.localizedContext(context)

        val openAppIntent = Intent(Intent.ACTION_VIEW, Uri.parse("sparkyfitnessmobile://"))
            .setPackage(context.packageName)
        val searchIntent = Intent(Intent.ACTION_VIEW, Uri.parse("sparkyfitnessmobile://search"))
            .setPackage(context.packageName)
        val scanIntent = Intent(Intent.ACTION_VIEW, Uri.parse("sparkyfitnessmobile://scan"))
            .setPackage(context.packageName)
        val searchFoodLabel = widgetContext.getString(R.string.widget_search_food)
        val scanBarcodeLabel = widgetContext.getString(R.string.widget_scan_barcode)

        Box(
            modifier = GlanceModifier
                .fillMaxSize()
                .background(WidgetPalette.surface)
                .appWidgetBackgroundCornerRadius()
                .padding(14.dp)
                .clickable(actionStartActivity(openAppIntent)),
            contentAlignment = Alignment.Center,
        ) {
            Column(modifier = GlanceModifier.fillMaxWidth()) {
                CalorieHeader(context = widgetContext, snapshot = snapshot)
                Spacer(modifier = GlanceModifier.height(10.dp))
                MacroRings(context = widgetContext, snapshot = snapshot)
                Spacer(modifier = GlanceModifier.height(10.dp))
                Row(
                    modifier = GlanceModifier.fillMaxWidth(),
                    verticalAlignment = Alignment.CenterVertically,
                ) {
                    ActionButton(
                        intent = searchIntent,
                        icon = R.drawable.ic_widget_search,
                        contentDescription = searchFoodLabel,
                        modifier = GlanceModifier
                            .defaultWeight()
                            .height(40.dp),
                    )
                    Box(
                        modifier = GlanceModifier
                            .width(1.dp)
                            .height(24.dp)
                            .background(WidgetPalette.divider),
                    ) {}
                    ActionButton(
                        intent = scanIntent,
                        icon = R.drawable.ic_widget_scan,
                        contentDescription = scanBarcodeLabel,
                        modifier = GlanceModifier
                            .defaultWeight()
                            .height(40.dp),
                    )
                }
            }
        }
    }

    @Composable
    private fun CalorieHeader(context: Context, snapshot: MacroSnapshot?, fontSize: Int = 16) {
        val calories = snapshot?.displayCalories
        val text = if (snapshot?.hasData == true && calories != null) {
            context.getString(R.string.widget_kcal_left, formatInt(context, calories))
        } else {
            context.getString(R.string.widget_kcal_left_empty)
        }
        Text(
            text = text,
            style = TextStyle(
                color = WidgetPalette.eaten,
                fontSize = fontSize.sp,
                fontWeight = FontWeight.Bold,
            ),
            maxLines = 1,
            modifier = GlanceModifier.fillMaxWidth(),
        )
    }

    /** Protein, carbs and fat as the Tracker's nutrient rings, side by side. */
    @Composable
    private fun MacroRings(context: Context, snapshot: MacroSnapshot?) {
        Row(
            modifier = GlanceModifier.fillMaxWidth(),
            verticalAlignment = Alignment.Top,
        ) {
            MacroRing(
                context = context,
                label = context.getString(R.string.widget_protein),
                kind = MacroKind.PROTEIN,
                snapshot = snapshot,
                modifier = GlanceModifier.defaultWeight(),
            )
            MacroRing(
                context = context,
                label = context.getString(R.string.widget_carbs),
                kind = MacroKind.CARBS,
                snapshot = snapshot,
                modifier = GlanceModifier.defaultWeight(),
            )
            MacroRing(
                context = context,
                label = context.getString(R.string.widget_fat),
                kind = MacroKind.FAT,
                snapshot = snapshot,
                modifier = GlanceModifier.defaultWeight(),
            )
        }
    }

    /**
     * One nutrient: a ring in its colour with the grams eaten inside, its name
     * under it, and what is left of its goal under that.
     */
    @Composable
    private fun MacroRing(
        context: Context,
        label: String,
        kind: MacroKind,
        snapshot: MacroSnapshot?,
        modifier: GlanceModifier,
    ) {
        val grams = snapshot?.gramsFor(kind) ?: 0.0
        val goal = snapshot?.goalFor(kind)
        val ring = WidgetGraphics.ring(
            context = context,
            sizeDp = RING_SIZE_DP,
            strokeDp = RING_STROKE_DP,
            progress = snapshot.progressFor(kind),
            color = kind.ink(context),
            trackColor = WidgetInk.track(context),
        )
        val leftText = if (goal != null && goal > 0.0) {
            context.getString(
                R.string.widget_grams_left,
                formatInt(context, (goal - grams).coerceAtLeast(0.0)),
            )
        } else {
            " "
        }
        Column(
            modifier = modifier,
            horizontalAlignment = Alignment.CenterHorizontally,
        ) {
            Box(
                modifier = GlanceModifier.size(RING_SIZE_DP.dp),
                contentAlignment = Alignment.Center,
            ) {
                Image(
                    provider = ImageProvider(ring),
                    contentDescription = null,
                    modifier = GlanceModifier.fillMaxSize(),
                )
                Text(
                    text = context.getString(R.string.widget_grams, formatInt(context, grams)),
                    style = TextStyle(
                        color = WidgetPalette.textPrimary,
                        fontSize = 11.sp,
                        fontWeight = FontWeight.Bold,
                    ),
                    maxLines = 1,
                )
            }
            Spacer(modifier = GlanceModifier.height(3.dp))
            Text(
                text = label,
                style = TextStyle(
                    color = kind.color,
                    fontSize = 11.sp,
                    fontWeight = FontWeight.Medium,
                ),
                maxLines = 1,
            )
            Text(
                text = leftText,
                style = TextStyle(
                    color = WidgetPalette.textMuted,
                    fontSize = 10.sp,
                ),
                maxLines = 1,
            )
        }
    }

    @Composable
    private fun ActionButton(
        intent: Intent,
        icon: Int,
        contentDescription: String,
        modifier: GlanceModifier = GlanceModifier
            .fillMaxWidth()
            .height(42.dp),
    ) {
        Box(
            modifier = modifier.clickable(actionStartActivity(intent)),
            contentAlignment = Alignment.Center,
        ) {
            Image(
                provider = ImageProvider(icon),
                contentDescription = contentDescription,
                colorFilter = ColorFilter.tint(WidgetPalette.eaten),
                modifier = GlanceModifier.size(24.dp),
            )
        }
    }

    private data class MacroSnapshot(
        val date: String,
        val protein: Double,
        val carbs: Double,
        val fat: Double,
        val calories: Double,
        val remaining: Double?,
        val proteinGoal: Double?,
        val carbsGoal: Double?,
        val fatGoal: Double?,
        val lastUpdated: Long,
    ) {
        val proteinKcal: Double = protein * 4.0
        val carbsKcal: Double = carbs * 4.0
        val fatKcal: Double = fat * 9.0
        val macroKcalTotal: Double = proteinKcal + carbsKcal + fatKcal
        val displayCalories: Double? = remaining ?: calories
        val hasData: Boolean =
            macroKcalTotal > 0.0 || (displayCalories ?: 0.0) > 0.0
    }

    private enum class MacroKind {
        PROTEIN,
        CARBS,
        FAT;

        val color: ColorProvider
            get() = when (this) {
                PROTEIN -> WidgetPalette.protein
                CARBS -> WidgetPalette.carbs
                FAT -> WidgetPalette.fat
            }

        fun ink(context: Context): Int = when (this) {
            PROTEIN -> WidgetInk.protein(context)
            CARBS -> WidgetInk.carbs(context)
            FAT -> WidgetInk.fat(context)
        }
    }

    private fun MacroSnapshot.gramsFor(kind: MacroKind): Double = when (kind) {
        MacroKind.PROTEIN -> protein
        MacroKind.CARBS -> carbs
        MacroKind.FAT -> fat
    }

    private fun MacroSnapshot.goalFor(kind: MacroKind): Double? = when (kind) {
        MacroKind.PROTEIN -> proteinGoal
        MacroKind.CARBS -> carbsGoal
        MacroKind.FAT -> fatGoal
    }

    private fun loadSnapshot(context: Context): MacroSnapshot? {
        val prefs = context.getSharedPreferences(
            MacroWidgetReceiver.PREFS_NAME,
            Context.MODE_PRIVATE,
        )
        return parseSnapshot(prefs.getString(MacroWidgetReceiver.PREFS_KEY_SNAPSHOT, null))
    }

    private fun parseSnapshot(json: String?): MacroSnapshot? {
        if (json == null) return null
        return try {
            val obj = JSONObject(json)
            val date = obj.optString("date", "")
            if (!isToday(date)) return null
            MacroSnapshot(
                date = date,
                protein = obj.safeDouble("protein"),
                carbs = obj.safeDouble("carbs"),
                fat = obj.safeDouble("fat"),
                calories = obj.safeDouble("calories"),
                remaining = obj.optionalDouble("remaining"),
                proteinGoal = obj.optionalDouble("proteinGoal"),
                carbsGoal = obj.optionalDouble("carbsGoal"),
                fatGoal = obj.optionalDouble("fatGoal"),
                lastUpdated = obj.optLong("lastUpdated", 0L),
            )
        } catch (e: Exception) {
            null
        }
    }

    /**
     * Progress toward each macro's own goal, which is what a per-macro ring
     * reads as — the Tracker's nutrient rings fill the same way.
     *
     * These are three independent rings, so a share-of-total would be the wrong
     * shape: those three fractions always sum to one, and a day's macro ratio
     * barely shifts as the day fills up, so the rings would look frozen while
     * the kcal header moved (#2228).
     */
    private fun MacroSnapshot?.progressFor(kind: MacroKind): Float {
        val snapshot = this ?: return 0f

        val consumed = when (kind) {
            MacroKind.PROTEIN -> snapshot.protein
            MacroKind.CARBS -> snapshot.carbs
            MacroKind.FAT -> snapshot.fat
        }
        val goal = when (kind) {
            MacroKind.PROTEIN -> snapshot.proteinGoal
            MacroKind.CARBS -> snapshot.carbsGoal
            MacroKind.FAT -> snapshot.fatGoal
        }

        if (goal != null && goal > 0.0) {
            return (consumed / goal).coerceIn(0.0, 1.0).toFloat()
        }

        // No goal in the snapshot: either it predates the goal fields (the app
        // has not refreshed the widget since updating) or the user has no goal
        // set for this macro. Fall back to the old share-of-total so the bar
        // still carries some signal rather than collapsing to empty.
        val total = snapshot.macroKcalTotal
        if (total <= 0.0) return 0f

        val value = when (kind) {
            MacroKind.PROTEIN -> snapshot.proteinKcal
            MacroKind.CARBS -> snapshot.carbsKcal
            MacroKind.FAT -> snapshot.fatKcal
        }
        return (value / total).coerceIn(0.0, 1.0).toFloat()
    }

    private fun JSONObject.safeDouble(name: String): Double {
        val value = optDouble(name, 0.0)
        return if (value.isFinite()) value else 0.0
    }

    /** Absent, JSON null and non-finite all read as "not supplied". */
    private fun JSONObject.optionalDouble(name: String): Double? {
        if (!has(name) || isNull(name)) return null
        val value = optDouble(name, Double.NaN)
        return if (value.isFinite()) value else null
    }

    private fun isToday(date: String): Boolean {
        if (date.isBlank()) return false
        return try {
            val parsed = LocalDate.parse(date, DateTimeFormatter.ISO_LOCAL_DATE)
            parsed == LocalDate.now()
        } catch (e: Exception) {
            false
        }
    }

    private fun formatInt(context: Context, value: Double): String {
        // Pre-localization rounding preserved: the macro widget rounds
        // (1240.7 -> 1241) — see 22415819.
        return formatWidgetInt(context, value.roundToLong())
    }

    companion object {
        val SNAPSHOT_STATE_KEY = stringPreferencesKey(MacroWidgetReceiver.PREFS_KEY_SNAPSHOT)
        private const val RING_SIZE_DP = 52f
        private const val RING_STROKE_DP = 6f
    }
}
