EXPO_PUBLIC_API_URL=https://fit.qla.dev/endpoints/api

# Public keys live in app.json expo.extra (revenueCat, googleAuth). These
# only override them, e.g. for a different RevenueCat project.
EXPO_PUBLIC_REVENUECAT_APPLE_API_KEY=
EXPO_PUBLIC_REVENUECAT_GOOGLE_API_KEY=
EXPO_PUBLIC_REVENUECAT_TEST_STORE_API_KEY=
# 1 = development bundles buy from the RevenueCat Test Store.
EXPO_PUBLIC_REVENUECAT_USE_TEST_STORE=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
