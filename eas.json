{
  "cli": {
    "version": ">= 16.28.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "env": {
        "APP_VARIANT": "development",
        "EXPO_PUBLIC_REVENUECAT_USE_TEST_STORE": "1"
      },
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "env": {
        "APP_VARIANT": "preview"
      },
      "distribution": "internal"
    },
    "production": {
      "env": {
        "APP_VARIANT": "production"
      },
      "android": {
        "buildType": "app-bundle"
      },
      "ios": {
        "resourceClass": "medium"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6810657126"
      }
    }
  }
}
